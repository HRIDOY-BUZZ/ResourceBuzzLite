<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>

  <object class="AdwPreferencesPage" id="settings_page">
    <property name="title">Settings</property>
    <property name="icon-name">preferences-system-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title">Display</property>
        <child>
          <object class="AdwSpinRow" id="refreshtime_spin">
            <property name="title">Refresh Interval</property>
            <property name="subtitle">Seconds between resource updates</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="lower">1</property>
                <property name="upper">60</property>
                <property name="step-increment">1</property>
                <property name="page-increment">5</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwComboRow" id="position_combo">
            <property name="title">Panel Position</property>
            <property name="model">
              <object class="GtkStringList">
                <items>
                  <item>Left</item>
                  <item>Center</item>
                  <item>Right</item>
                </items>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="decimals_switch">
            <property name="title">Show Decimals</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="showcolors_switch">
            <property name="title">Show Usage Colors</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <property name="title">Resources</property>
        <child>
          <object class="AdwSwitchRow" id="cpu_switch">
            <property name="title">CPU Usage</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="ram_switch">
            <property name="title">RAM Usage</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="thermal_switch">
            <property name="title">CPU Temperature</property>
            <property name="subtitle">Show the hottest valid CPU-related sensor</property>
          </object>
        </child>
        <child>
          <object class="AdwComboRow" id="thermal_unit_combo">
            <property name="title">Temperature Unit</property>
            <property name="model">
              <object class="GtkStringList">
                <items>
                  <item>Celsius (°C)</item>
                  <item>Fahrenheit (°F)</item>
                </items>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <property name="title">Mouse Actions</property>
        <child>
          <object class="AdwComboRow" id="left_click_app_combo">
            <property name="title">Left-click App</property>
            <property name="subtitle">App to open when the panel indicator is clicked</property>
            <property name="model">
              <object class="GtkStringList">
                <items>
                  <item>Resources</item>
                  <item>GNOME System Monitor</item>
                  <item>Mission Center</item>
                </items>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="right_click_switch">
            <property name="title">Right-click Opens Preferences</property>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="AdwPreferencesPage" id="about_page">
    <property name="title">About</property>
    <property name="icon-name">help-about-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <child>
          <object class="AdwActionRow">
            <property name="title">ResourceBuzz Lite</property>
            <property name="subtitle">CPU, RAM, and CPU temperature monitor</property>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title">Developer</property>
            <property name="subtitle">hridoybuzz.dev</property>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title">Source Code</property>
            <property name="subtitle">github.com/HRIDOY-BUZZ/ResourceBuzzLite</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
